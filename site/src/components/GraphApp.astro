---
/**
 * The homepage graph app shell (Task 12). Markup only; `src/graph/main.ts`
 * initialises `#graph-app` (canvas, input, panel, hash, theme toggle).
 *
 * State attributes on `#graph-app`, read by e2e:
 * - `data-level`: `levelOf(cam.k)`, 0 | 1 | 2
 * - `data-focus`: focused node id, or empty
 * - `data-ready`: present once the graph is drawn
 *
 * `#graph-search` and `#graph-filter-btn` are filled in by Task 13.
 */
import { toRoute } from '../lib/routes';
const catalog = toRoute('wiki/index');
---

<div id="graph-app" class="graph-app" data-level="0" data-focus="">
  <canvas class="graph-canvas" aria-label="知识图谱：Agent 居中，主题环绕。滚轮或双指缩放，拖动平移，+ 和 - 缩放，0 回到全局。" role="img"></canvas>

  <header class="graph-bar">
    <a class="graph-brand" href={toRoute('index')}>
      <svg class="graph-brand__mark" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4.2"></circle>
        <circle cx="12" cy="3.6" r="1.8"></circle>
        <circle cx="19.6" cy="15.6" r="1.8"></circle>
        <circle cx="4.4" cy="15.6" r="1.8"></circle>
        <path d="M12 7.8V5.4M15.6 14l2.4 1M8.4 14 6 15"></path>
      </svg>
      <span>Agent LLM Wiki</span>
    </a>
    <div id="graph-search" class="graph-bar__search"></div>
    <nav class="graph-bar__actions" aria-label="站点">
      <button id="graph-filter-btn" class="graph-btn" type="button" hidden>过滤</button>
      <a class="graph-btn" href={catalog}>目录</a>
      <button id="graph-theme-btn" class="graph-btn graph-btn--icon" type="button" aria-label="切换深色模式" aria-pressed="false">
        <svg class="graph-icon graph-icon--moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
        </svg>
        <svg class="graph-icon graph-icon--sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"></path>
        </svg>
      </button>
    </nav>
  </header>

  <p class="graph-status" role="status">正在加载图谱…</p>

  <aside class="graph-panel" aria-hidden="true" aria-labelledby="graph-panel-title">
    <button class="graph-panel__close" type="button" aria-label="关闭预览">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
    </button>
    <span class="graph-panel__type"></span>
    <h2 class="graph-panel__title" id="graph-panel-title"></h2>
    <p class="graph-panel__summary"></p>
    <a class="graph-panel__open" href={catalog}>打开页面<span aria-hidden="true">→</span></a>
    <section class="graph-panel__related" hidden>
      <h3 class="graph-panel__heading">最近素材</h3>
      <ol class="graph-panel__list"></ol>
    </section>
  </aside>

  <p class="graph-hint" aria-hidden="true">滚轮缩放 · 拖动平移 · 点击主题或概念飞入</p>
</div>

<script>
  import '../graph/main';
</script>

<style is:global>
  :root {
    --g-bg: #f6f7fb;
    --g-bg-deep: #e9ecf5;
    --g-glass: rgba(255, 255, 255, 0.72);
    --g-glass-border: rgba(15, 23, 42, 0.08);
    --g-panel: rgba(255, 255, 255, 0.9);
    --g-btn-hover: rgba(55, 48, 163, 0.08);
    --g-accent: var(--c-topic);
    --g-font: system-ui, -apple-system, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  }
  :root[data-theme='dark'] {
    --g-bg: #0e111b;
    --g-bg-deep: #070910;
    --g-glass: rgba(24, 28, 42, 0.72);
    --g-glass-border: rgba(226, 232, 240, 0.1);
    --g-panel: rgba(22, 26, 40, 0.92);
    --g-btn-hover: rgba(165, 180, 252, 0.12);
  }

  html,
  body {
    margin: 0;
    height: 100%;
    overflow: hidden;
    background: var(--g-bg);
    color: var(--c-ink);
    font-family: var(--g-font);
    -webkit-font-smoothing: antialiased;
  }

  .graph-app {
    position: fixed;
    inset: 0;
    overflow: hidden;
    background: radial-gradient(ellipse at 50% 45%, var(--g-bg) 0%, var(--g-bg) 45%, var(--g-bg-deep) 100%);
  }
  .graph-canvas {
    position: absolute;
    inset: 0;
    display: block;
    touch-action: none;
    cursor: grab;
    -webkit-tap-highlight-color: transparent;
  }
  .graph-canvas.is-dragging {
    cursor: grabbing;
  }
  .graph-canvas:focus-visible {
    outline: none;
  }

  /* ---- top bar */
  .graph-bar {
    position: absolute;
    top: max(12px, env(safe-area-inset-top));
    left: 16px;
    right: 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    pointer-events: none;
  }
  .graph-bar > * {
    pointer-events: auto;
  }
  .graph-brand,
  .graph-bar__actions {
    display: flex;
    align-items: center;
    height: 40px;
    border-radius: 12px;
    background: var(--g-glass);
    border: 1px solid var(--g-glass-border);
    box-shadow: var(--card-shadow);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
  }
  .graph-brand {
    gap: 8px;
    padding: 0 14px 0 10px;
    color: var(--c-ink);
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .graph-brand__mark {
    width: 22px;
    height: 22px;
    fill: color-mix(in srgb, var(--g-accent) 22%, transparent);
    stroke: var(--g-accent);
    stroke-width: 1.4;
    stroke-linecap: round;
  }
  .graph-bar__search {
    flex: 1;
    min-width: 0;
    display: flex;
    justify-content: flex-end;
  }
  .graph-bar__search:empty {
    pointer-events: none;
  }
  .graph-bar__actions {
    gap: 2px;
    padding: 0 4px;
  }
  .graph-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 32px;
    padding: 0 12px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--c-ink);
    font: 500 14px/1 var(--g-font);
    text-decoration: none;
    cursor: pointer;
  }
  .graph-btn[hidden] {
    display: none;
  }
  .graph-btn:hover {
    background: var(--g-btn-hover);
  }
  .graph-btn:focus-visible,
  .graph-brand:focus-visible,
  .graph-panel a:focus-visible,
  .graph-panel__close:focus-visible {
    outline: 2px solid var(--g-accent);
    outline-offset: 2px;
  }
  .graph-btn--icon {
    width: 32px;
    padding: 0;
  }
  .graph-icon {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .graph-icon--sun,
  :root[data-theme='dark'] .graph-icon--moon {
    display: none;
  }
  :root[data-theme='dark'] .graph-icon--sun {
    display: block;
  }

  /* ---- status + hint */
  .graph-status {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    padding: 16px;
    text-align: center;
    color: var(--c-muted);
    font-size: 14px;
    pointer-events: none;
  }
  .graph-status[data-state='error'] {
    color: var(--c-ink);
  }
  .graph-hint {
    position: absolute;
    left: 16px;
    bottom: max(14px, env(safe-area-inset-bottom));
    margin: 0;
    color: var(--c-muted);
    font-size: 12px;
    pointer-events: none;
    transition: opacity 0.3s;
  }
  .graph-app:has(.graph-panel[data-open]) .graph-hint {
    opacity: 0;
  }
  @media (hover: none) {
    .graph-hint {
      display: none;
    }
  }

  /* ---- preview panel: right card, bottom sheet below 640px */
  .graph-panel {
    position: absolute;
    top: 68px;
    right: 16px;
    bottom: 16px;
    width: 340px;
    max-height: calc(100% - 84px);
    height: fit-content;
    box-sizing: border-box;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 20px 20px 18px;
    border-radius: 16px;
    background: var(--g-panel);
    border: 1px solid var(--g-glass-border);
    box-shadow: var(--card-shadow), 0 18px 48px rgba(15, 23, 42, 0.12);
    backdrop-filter: blur(18px) saturate(1.4);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    opacity: 0;
    transform: translateX(16px);
    visibility: hidden;
    transition: opacity 0.22s ease, transform 0.22s ease, visibility 0s linear 0.22s;
  }
  .graph-panel[data-open] {
    opacity: 1;
    transform: none;
    visibility: visible;
    transition: opacity 0.22s ease, transform 0.22s ease;
  }
  .graph-panel__close {
    position: absolute;
    top: 12px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--c-muted);
    cursor: pointer;
  }
  .graph-panel__close:hover {
    background: var(--g-btn-hover);
    color: var(--c-ink);
  }
  .graph-panel__close svg {
    width: 16px;
    height: 16px;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  .graph-panel__type {
    --tone: var(--c-topic);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--tone);
  }
  .graph-panel__type::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--tone);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--tone) 20%, transparent);
  }
  [data-type='concept'] {
    --tone: var(--c-concept);
  }
  [data-type='paper'] {
    --tone: var(--c-paper);
  }
  [data-type='blog'] {
    --tone: var(--c-blog);
  }
  [data-type='video'] {
    --tone: var(--c-video);
  }
  [data-type='podcast'] {
    --tone: var(--c-podcast);
  }
  [data-type='entity'] {
    --tone: var(--c-entity);
  }
  .graph-panel__title {
    margin: 8px 32px 0 0;
    font-size: 20px;
    line-height: 1.35;
    font-weight: 650;
    color: var(--c-ink);
  }
  .graph-panel__summary {
    margin: 8px 0 0;
    font-size: 14px;
    line-height: 1.65;
    color: var(--c-muted);
  }
  .graph-panel__open {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 16px;
    padding: 8px 14px;
    border-radius: 10px;
    background: var(--g-accent);
    color: var(--card-bg);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: filter 0.15s;
  }
  .graph-panel__open:hover {
    filter: brightness(1.1);
  }
  .graph-panel__related {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--card-border);
  }
  .graph-panel__related[hidden] {
    display: none;
  }
  .graph-panel__heading {
    margin: 0 0 10px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--c-muted);
  }
  .graph-panel__list {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .graph-panel__item {
    padding-left: 12px;
    border-left: 2px solid color-mix(in srgb, var(--tone, var(--c-paper)) 55%, transparent);
  }
  .graph-panel__item:has([data-type='blog']) {
    --tone: var(--c-blog);
  }
  .graph-panel__item:has([data-type='video']) {
    --tone: var(--c-video);
  }
  .graph-panel__item:has([data-type='podcast']) {
    --tone: var(--c-podcast);
  }
  .graph-panel__item-link {
    display: grid;
    gap: 2px;
    color: var(--c-ink);
    text-decoration: none;
  }
  .graph-panel__item-title {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
  }
  .graph-panel__item-link:hover .graph-panel__item-title {
    color: var(--tone, var(--c-paper));
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .graph-panel__item-meta {
    font-size: 12px;
    color: var(--c-muted);
  }
  .graph-panel__item-insight {
    margin: 6px 0 0;
    font-size: 13px;
    line-height: 1.6;
    color: var(--c-ink);
    opacity: 0.86;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: opacity 0.2s;
  }
  .graph-panel__item-insight.is-pending {
    opacity: 0.5;
  }
  .graph-panel__empty {
    font-size: 13px;
    color: var(--c-muted);
  }

  @media (max-width: 639.98px) {
    .graph-bar {
      left: 12px;
      right: 12px;
      gap: 8px;
    }
    .graph-brand {
      padding: 0 12px 0 8px;
      font-size: 14px;
    }
    .graph-panel {
      top: auto;
      left: 0;
      right: 0;
      bottom: 0;
      width: auto;
      max-height: 58%;
      padding: 22px 18px max(18px, env(safe-area-inset-bottom));
      border-radius: 18px 18px 0 0;
      border-bottom: 0;
      background: var(--card-bg);
      box-shadow: 0 -8px 32px rgba(15, 23, 42, 0.16);
      transform: translateY(24px);
    }
    .graph-panel::before {
      content: '';
      position: absolute;
      top: 8px;
      left: 50%;
      width: 36px;
      height: 4px;
      margin-left: -18px;
      border-radius: 2px;
      background: var(--card-border);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .graph-panel,
    .graph-panel[data-open] {
      transition: none;
    }
  }
</style>
